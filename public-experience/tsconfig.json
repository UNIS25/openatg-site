{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true, "jsx": "react-jsx",
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "types": ["node"], "noEmit": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.tsx", "tests/**/*.ts", "playwright.config.ts"]
}
