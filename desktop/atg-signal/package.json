{
  "name": "atg-signal-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "stage": "node scripts/stage-frontend.mjs",
    "icons": "node scripts/generate-macos-icons.mjs",
    "icons:windows": "node scripts/generate-windows-icon.mjs",
    "licenses": "node scripts/generate-third-party-notices.mjs && node scripts/generate-windows-third-party-notices.mjs",
    "build": "tauri build --target aarch64-apple-darwin --bundles app,dmg",
    "build:windows": "npm run icons:windows && tauri build --target x86_64-pc-windows-msvc --bundles nsis,msi --ci --no-sign -- --locked",
    "test:config": "npm run stage && node scripts/validate-desktop-config.mjs",
    "test:staged": "node scripts/validate-staged-frontend.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4"
  },
  "engines": {
    "node": ">=22"
  }
}
