{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ATG Signal",
  "version": "1.0.0",
  "identifier": "com.openatg.signal",
  "build": {
    "beforeDevCommand": "npm run stage",
    "beforeBuildCommand": "npm run stage",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ATG Signal",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "decorations": true,
        "fullscreen": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": true,
        "devtools": false,
        "backgroundColor": "#ffffff",
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self'; script-src 'self'; worker-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'",
      "freezePrototype": true,
      "capabilities": ["main-local-reports"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "copyright": "Copyright © 2026 OpenATG",
    "shortDescription": "Private, offline social media reporting",
    "longDescription": "ATG Signal creates weekly social media performance reports locally and offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": ["../THIRD_PARTY_NOTICES.md", "../WINDOWS_THIRD_PARTY_NOTICES.md"],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "files": {},
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    }
  }
}
