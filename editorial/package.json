{
  "name": "varathans25-packaging-editorial",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint src scripts tests *.mjs",
    "build": "node scripts/tea-tins.mjs prepare && node scripts/build.mjs && node scripts/tea-tins.mjs publish",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "1.47.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "sharp": "0.35.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
