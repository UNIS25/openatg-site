      "title": {
        "en": "Kalu River Basin",
        "si": "කළු ගඟ ද්‍රෝණිය",
        "ta": "களு கங்கை ஆற்றுப் படுகை"
      },
      "authority": "Irrigation Department",
      "issuedAt": "2026-10-26T11:30:00+05:30",
      "expiresAt": "2026-10-27T11:30:00+05:30",
