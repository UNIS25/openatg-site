{
  "name": "varathans25-commerce",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4175",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts *.ts",
    "test": "vitest run && node ../scripts/validate-varathans25-catalogue.mjs",
    "test:db": "supabase test db --workdir ..",
    "test:e2e": "playwright test",
    "backend:start": "supabase start --workdir ..",
    "backend:reset": "supabase db reset --workdir ..",
    "backend:stop": "supabase stop --workdir ..",
    "backend:env": "node scripts/local-env.mjs",
    "test:integration": "node --env-file=.env.local --import tsx --test tests/backend.integration.ts",
    "test:security": "node --env-file=.env.local --import tsx --test tests/security.integration.ts",
    "build:harness": "vite build --config vite.harness.config.ts",
    "serve:verification": "node scripts/serve.mjs",
    "test:backend": "npm run backend:reset && npm run test:db && npm run test:integration && npm run test:security",
    "export:fallback": "node --env-file=.env.local scripts/export-fallback.mjs",
    "stage:pages": "node scripts/stage-pages.mjs",
    "deploy:preflight": "node scripts/deploy-preflight.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "otpauth": "^9.4.0",
    "prettier": "^3.9.8",
    "supabase": "^2.49.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.1"
  }
}
